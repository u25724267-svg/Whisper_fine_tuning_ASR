{
  "research_question": "RQ1",
  "experiment_id": "rq1-c2-snr-seed43",
  "hypothesis": "C2 strict SNR seed-42 behavior is stable under matched seed 43.",
  "control_experiment": "rq1-c0-random-seed43-v2",
  "experiment_name": "rq1-c2-snr-seed43",
  "runner": "train_snr_curriculum.py",
  "model": {
    "id": "openai/whisper-base",
    "revision": "e37978b90ca9030d5170a5c07aadb050351a65bb",
    "language": "shona",
    "task": "transcribe",
    "clear_forced_decoder_ids": true,
    "clear_suppress_tokens": true
  },
  "curriculum": {
    "type": "snr",
    "metadata_path": "/ext_data/casper/asr_data/waxal_shona_speaker_disjoint_v2/acoustic_metadata.csv",
    "score": "1 - training_split_average_rank_percentile(snr_proxy_db)",
    "order": "difficulty_ascending_equivalent_to_snr_descending",
    "tie_break": [
      "utterance_id",
      "dataset_index"
    ],
    "apply_each_epoch": true,
    "save_epoch_orders": true
  },
  "augmentation": {
    "type": "none",
    "enabled": false
  },
  "data": {
    "protocol": "waxal_shona_speaker_disjoint_v2",
    "protocol_summary": "/ext_data/casper/asr_data/waxal_shona_speaker_disjoint_v2/split_summary.json",
    "train_manifest": "/ext_data/casper/asr_data/waxal_shona_speaker_disjoint_v2/train.jsonl",
    "validation_manifest": "/ext_data/casper/asr_data/waxal_shona_speaker_disjoint_v2/validation.jsonl",
    "test_manifest": "/ext_data/casper/asr_data/waxal_shona_speaker_disjoint_v2/test.jsonl",
    "audio_column": "audio_filepath",
    "text_column": "text",
    "sampling_rate": 16000,
    "keep_preprocessed_in_memory": true
  },
  "training": {
    "num_train_epochs": 3.0,
    "seed": 43,
    "per_device_train_batch_size": 6,
    "per_device_eval_batch_size": 6,
    "gradient_accumulation_steps": 1,
    "learning_rate": 1e-05,
    "warmup_steps": 500,
    "gradient_checkpointing": true,
    "gradient_checkpointing_kwargs": {
      "use_reentrant": false
    },
    "fp16": true,
    "full_determinism": true,
    "eval_strategy": "epoch",
    "predict_with_generate": true,
    "generation_max_length": 225,
    "save_strategy": "epoch",
    "save_total_limit": 3,
    "logging_steps": 250,
    "load_best_model_at_end": true,
    "metric_for_best_model": "wer",
    "greater_is_better": false
  },
  "output_dir": "rq1/c2_snr_seed43",
  "resources": {
    "min_free_gpu_mb": 20000,
    "min_free_disk_gb": 8
  },
  "wandb": {
    "project": "whisper-shona-multilingual",
    "run_name": "rq1-c2-snr-seed43",
    "job_type": "posthoc-seed-replication",
    "tags": [
      "rq1",
      "c2",
      "snr-curriculum",
      "whisper-base",
      "shona",
      "speaker-disjoint-v2",
      "epoch-checkpoints",
      "seed-43",
      "posthoc-replication"
    ],
    "watch": "false",
    "log_model": "false",
    "resume_run_id": null
  }
}
