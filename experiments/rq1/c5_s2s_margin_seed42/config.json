{
  "research_question": "RQ1",
  "experiment_id": "rq1-c5-s2s-margin-seed42",
  "hypothesis": "Dynamic ordering by prior-epoch sequence NLL per audio second improves unseen-speaker ASR over fixed and random curricula.",
  "control_experiment": "rq1-c0-random-seed42-v2",
  "experiment_name": "rq1-c5-s2s-margin-seed42",
  "runner": "train_s2s_curriculum.py",
  "model": {
    "id": "openai/whisper-base",
    "revision": "e37978b90ca9030d5170a5c07aadb050351a65bb",
    "language": "shona",
    "task": "transcribe",
    "clear_forced_decoder_ids": true,
    "clear_suppress_tokens": true
  },
  "curriculum": {
    "type": "s2s_margin",
    "epoch_1_order": "seeded_random",
    "score": "summed_token_nll_per_audio_second",
    "score_update": "epoch_boundary",
    "later_epoch_order": "ascending_prior_epoch_score",
    "tie_breakers": ["duration", "utterance_id", "dataset_index"],
    "sampling": "without_replacement",
    "difficulty_mixing": false,
    "save_epoch_orders": true,
    "save_item_scores": true
  },
  "augmentation": {"type": "none", "enabled": false},
  "data": {
    "protocol": "waxal_shona_speaker_disjoint_v2",
    "protocol_summary": "/ext_data/casper/asr_data/waxal_shona_speaker_disjoint_v2/split_summary.json",
    "train_manifest": "/ext_data/casper/asr_data/waxal_shona_speaker_disjoint_v2/train.jsonl",
    "validation_manifest": "/ext_data/casper/asr_data/waxal_shona_speaker_disjoint_v2/validation.jsonl",
    "test_manifest": "/ext_data/casper/asr_data/waxal_shona_speaker_disjoint_v2/test.jsonl",
    "audio_column": "audio_filepath",
    "text_column": "text",
    "sampling_rate": 16000,
    "keep_preprocessed_in_memory": true
  },
  "training": {
    "num_train_epochs": 3.0,
    "seed": 42,
    "per_device_train_batch_size": 6,
    "per_device_eval_batch_size": 6,
    "gradient_accumulation_steps": 1,
    "learning_rate": 1e-5,
    "warmup_steps": 500,
    "gradient_checkpointing": true,
    "gradient_checkpointing_kwargs": {"use_reentrant": false},
    "fp16": true,
    "full_determinism": true,
    "eval_strategy": "epoch",
    "predict_with_generate": true,
    "generation_max_length": 225,
    "save_strategy": "epoch",
    "save_total_limit": 3,
    "logging_steps": 250,
    "load_best_model_at_end": true,
    "metric_for_best_model": "wer",
    "greater_is_better": false
  },
  "output_dir": "rq1/c5_s2s_margin_seed42",
  "resources": {"min_free_gpu_mb": 10000, "min_free_disk_gb": 8},
  "wandb": {
    "project": "whisper-shona-multilingual",
    "run_name": "rq1-c5-s2s-margin-seed42",
    "job_type": "dynamic-curriculum-training",
    "tags": ["rq1", "c5", "s2s-margin", "dynamic", "whisper-base", "shona", "speaker-disjoint-v2", "seed-42"],
    "watch": "false",
    "log_model": "false",
    "resume_run_id": null
  }
}