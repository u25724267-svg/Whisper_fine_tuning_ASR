{
  "research_question": "RQ1",
  "experiment_id": "rq1-c1-sortagrad-seed42",
  "hypothesis": "Presenting shorter utterances first in epoch 1 improves optimization or generalization relative to C0-v2.",
  "control_experiment": "rq1-c0-random-seed42-v2",
  "experiment_name": "rq1-c1-sortagrad-seed42",
  "runner": "train_sortagrad.py",
  "model": {
    "id": "openai/whisper-base",
    "revision": "e37978b90ca9030d5170a5c07aadb050351a65bb",
    "language": "shona",
    "task": "transcribe",
    "clear_forced_decoder_ids": true,
    "clear_suppress_tokens": true
  },
  "curriculum": {
    "type": "sortagrad",
    "epoch_1": "duration_ascending",
    "later_epochs": "seeded_random_permutation",
    "duration_tie_break": ["utterance_id", "dataset_index"],
    "save_epoch_orders": true
  },
  "augmentation": {
    "type": "none",
    "enabled": false
  },
  "data": {
    "protocol": "waxal_shona_speaker_disjoint_v2",
    "protocol_summary": "/ext_data/casper/asr_data/waxal_shona_speaker_disjoint_v2/split_summary.json",
    "train_manifest": "/ext_data/casper/asr_data/waxal_shona_speaker_disjoint_v2/train.jsonl",
